# Server
BD_HOST=127.0.0.1
BD_PORT=8765

# Required when BD_HOST is set to a non-local interface such as 0.0.0.0.
# Leave blank for localhost-only use.
BD_REGISTRATION_CODE=

# Session lifetime in days.
BD_SESSION_DAYS=14

# Keep false for normal local/LAN HTTP use.
# Set true only when the site is served through HTTPS.
BD_COOKIE_SECURE=false

# One SQLite database for accounts, workspaces, provider balances, and login history.
# Relative paths are resolved from the project folder. Set this before the first
# launch when continuing with an existing dashboard database file.
BD_DATABASE_PATH=data/bd_dashboard.db

# Existing pre-workspace database upgrades only: choose an existing username to
# become admin. Other existing accounts migrate as members. The app creates a
# pre-migration backup next to the database in a `backups/` directory.
# Remove this setting after the first successful migration.
BD_INITIAL_ADMIN_USERNAME=
